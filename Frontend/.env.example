# Gemini API key for the chatbot (/api/chat). Without it the bot uses local replies.
GEMINI_API_KEY=

# Login OTP email — first configured provider wins: Resend, Brevo, then SMTP.
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Darsh Dental Depot
SMTP_FROM_EMAIL=

# Per-IP rate limits
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_MAX=20

# Default low-stock threshold for the public catalog
LOW_STOCK_THRESHOLD=10
