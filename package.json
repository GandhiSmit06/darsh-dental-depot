{
  "name": "darsh-dental-depot",
  "version": "2.0.0",
  "description": "Darsh Dental Depot — dental supply website, doctor portal and depot dashboards (Next.js + Supabase)",
  "private": true,
  "scripts": {
    "dev": "npm --workspace Frontend run dev",
    "build": "npm --workspace Frontend run build",
    "build:worker": "npm --workspace Frontend run build:worker",
    "preview:worker": "npm --workspace Frontend run preview:worker --",
    "deploy:worker": "npm --workspace Frontend run deploy:worker",
    "start": "npm --workspace Frontend run start",
    "lint": "npm --workspace Frontend run lint",
    "typecheck": "npm --workspace @darsh/backend run typecheck",
    "test": "npm --workspace @darsh/backend test"
  },
  "workspaces": [
    "Frontend",
    "Backend"
  ]
}
